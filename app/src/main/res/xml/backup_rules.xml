<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinnamon keeps learner progress, saved flashcards, and role-play-derived text
  on-device. There is currently no account-bound restore flow or user-facing
  consent for transferring that material, so do not export app-owned storage.

  Android 11 and lower read this file. The Android 12+ counterpart lives in
  data_extraction_rules.xml; both files intentionally cover every storage domain.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
